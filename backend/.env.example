DATABASE_URL=postgresql://neondb_owner:npg_pf7yELilVIS6@ep-lively-sound-a1z91rsb-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
APP_NAME=Workforce Roster API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- security (REQUIRED in production) ---
ENVIRONMENT=dev                 # prod = refuse to start with the default SECRET_KEY
SECRET_KEY=change-me-long-random-string-at-least-32-chars
AUTH_REQUIRED=true              # false = open API, demos only
TOKEN_MINUTES=480
REQUIRE_APPROVAL=true           # draft -> approve -> publish
SEPARATE_APPROVER=false         # true = publisher must differ from approver (four-eyes)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Roster engine (optional overrides)
DEFAULT_MORNING_REQUIRED=55
DEFAULT_EVENING_REQUIRED=45
DEFAULT_NIGHT_REQUIRED=14
DEFAULT_MIN_SENIOR=3
SOLVER_TIME_LIMIT_SECONDS=30
AUTO_ADJUST_TIME_LIMIT_SECONDS=20
SOLVER_WORKERS=8

# --- deployment (Step 10) ---
LOG_LEVEL=INFO
LOG_JSON=false                  # true in production
ENABLE_DOCS=true                # false in production
TRUSTED_HOSTS=*                 # production: your domain
FORCE_HTTPS_HEADERS=false       # production: true (behind HTTPS proxy)
SENTRY_DSN=
SLOW_REQUEST_MS=2000
LEAVE_MAX_BACKDATE_DAYS=30
LEAVE_MAX_FUTURE_DAYS=400
LEAVE_MAX_SPAN_DAYS=90
